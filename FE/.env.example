# The console's settings. Vite reads them when it starts or builds: copy this
# file to .env.local (not committed) and restart `npm run dev`.

# The API's address.
VITE_API_URL=http://localhost:3000

# Log in through Keycloak: the development realm runs with
#   docker compose --profile auth up -d --wait keycloak mailpit
# and the backend then needs FF_AUTH_MODE=oidc (see BE/.env.example).
#   VITE_OIDC_AUTHORITY=http://localhost:8180/realms/ff
# Empty: development mode, without a login. The backend must then run with
# FF_AUTH_MODE=dev, and the console acts as its development account.
VITE_OIDC_AUTHORITY=

# The console's client in that realm.
VITE_OIDC_CLIENT_ID=ff-console
