# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=serverless
DB_SYNC=false
DB_SSL=false

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=functions

# Nomad Configuration
NOMAD_ADDR=http://localhost:4646
NOMAD_TOKEN=your-nomad-token
NOMAD_REGION=global
NOMAD_NAMESPACE=default
NOMAD_DC=dc1

# Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=7d

# Function Configuration
FUNCTION_MEMORY_DEFAULT=128
FUNCTION_TIMEOUT_DEFAULT=30
FUNCTION_MAX_MEMORY=1024
FUNCTION_MAX_TIMEOUT=300

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
METRICS_INTERVAL=10000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev # dev or combined
LOG_DIR=logs

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cache
CACHE_TTL=3600
CACHE_MAX=100

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE=Serverless Platform API
SWAGGER_DESCRIPTION=API documentation for the Serverless Platform
SWAGGER_VERSION=1.0
SWAGGER_PATH=api-docs

# Security
SECURITY_ENABLE_RATE_LIMIT=true
SECURITY_ENABLE_HELMET=true
SECURITY_ENABLE_COMPRESSION=true
SECURITY_ENABLE_CORS=true

# Docker Configuration (for function containers)
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Debug
DEBUG_PORT=9229
DEBUG_ENABLED=false

# Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 0 * * *
BACKUP_DIR=/opt/backups

# Notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@example.com

# Feature Flags
FEATURE_PYTHON_RUNTIME=false
FEATURE_CUSTOM_DOMAINS=false
FEATURE_AUTO_SCALING=true
FEATURE_MONITORING=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
