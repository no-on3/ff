# Every variable is checked at boot, and a bad value stops the backend with a
# message naming it (src/config/configuration.ts). NODE_ENV=production also
# refuses the development settings marked below.

# Application
NODE_ENV=development
PORT=3000
# The console's and the admin dashboard's origins, comma-separated. Required in production.
CORS_ORIGIN=http://localhost:5199,http://localhost:5198

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Development default: refused in production
DB_PASSWORD=postgres
# The code reads DB_NAME (matches POSTGRES_DB in docker-compose.yml)
DB_NAME=serverless_platform
# TLS to the database: use it whenever the server is not on this host. The
# server's certificate is always verified, against DB_SSL_CA (a PEM file) when
# it is set, else against the system's CAs.
DB_SSL=false
DB_SSL_CA=

# S3-compatible storage. Variable names are still MINIO_* (renamed in parent
# plan F-15); the dev store is SeaweedFS from docker-compose.yml, with the
# credentials from infrastructure/seaweedfs/s3.json (local development only:
# refused in production, like the MinIO default minioadmin).
MINIO_ENDPOINT=localhost
MINIO_PORT=9003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ffdevaccesskey
MINIO_SECRET_KEY=ffdevsecretkey-local-only
MINIO_BUCKET_NAME=functions

# Orchestrator (Kubernetes is the only driver, ADR 0001)
ORCHESTRATOR=kubernetes
# How long create/update wait for a function to become ready
FF_READY_TIMEOUT_SECONDS=90
# Each account's plan sets its limits: functions, memory, timeout, instances,
# its namespace's quota, its rate limits, and the idle time before scale to
# zero (plans.limits; client-readiness plan, P-15). The backend no longer reads
# FF_SCALE_TO_ZERO_IDLE_SECONDS or K8S_TENANT_QUOTA_*, and refuses to start
# while they are set.

# How often FF deletes what it keeps only for a while: invocation history older
# than the plan allows, and the data of accounts closed past their notice period.
FF_RETENTION_INTERVAL_SECONDS=3600

# Notifications: how often the backend sends the e-mails and webhooks that are
# due, and whether a webhook may reach a private address, such as a receiver on
# this machine. Production refuses true.
FF_NOTIFY_INTERVAL_SECONDS=10
FF_WEBHOOK_ALLOW_PRIVATE=true

# Alarms: how often they are evaluated, and how long a period has been over
# before it is judged, so that a call ending then still counts in it.
FF_ALARM_INTERVAL_SECONDS=60
FF_ALARM_SETTLE_SECONDS=60

# The backend's logs: one JSON object a line (json, production's default) or
# readable lines (text, development's). The operator's metrics, in Prometheus's
# text format, on their own port, never the API's; 0 serves none. In a cluster,
# FF_METRICS_HOST=0.0.0.0 lets Prometheus reach them.
FF_LOG_FORMAT=text
FF_METRICS_PORT=9464
FF_METRICS_HOST=127.0.0.1

# Kubernetes (docs/kubernetes-dev-guide.md). hack/k8s/mint-token.sh prints
# these four for the dev cluster; inside a cluster leave them empty.
K8S_API_URL=https://127.0.0.1:6550
K8S_TOKEN_FILE=../hack/.kube/ff-controller.token
K8S_CA_FILE=../hack/.kube/ca.crt
K8S_INVOKE_MODE=proxy
# Only ff-t-: the admission policy lets the backend manage no other namespaces
K8S_NAMESPACE_PREFIX=ff-t-
K8S_RUNTIME_IMAGE_NODEJS=ff-runtime-nodejs:24-v2
K8S_RUNTIME_IMAGE_PYTHON=ff-runtime-python:3.13-v2
K8S_IMAGE_PULL_POLICY=IfNotPresent
# How long an invocation waits for a function scaled to zero to start again. A call still
# running after two timeouts, this, and 30 s lost its answer: the backend stopped during it,
# and marks it LOST, unbilled (P-20)
K8S_READY_TIMEOUT_SECONDS=90
# e.g. gvisor (needs the RuntimeClass and runsc on the nodes)
K8S_RUNTIME_CLASS=
K8S_EGRESS_INTERNET=true
K8S_INGRESS_ALLOW_CIDRS=
# The log store's delete key (P-45): closing an account deletes its functions' log lines
# with it. hack/k8s/logging-up.sh (or hack/k8s/log-store-key.sh) writes it there from the
# cluster's Secret; inside a cluster, leave it unset: the Secret is mounted at the default.
K8S_LOG_STORE_DELETE_KEY_FILE=../hack/.kube/victoria-logs-delete-key

# Authentication (docs/adr/0004-identity-and-tenancy.md)
# "dev" acts as the account FF_DEV_ACCOUNT_ID (12 digits) without any token, or
# as the one an X-FF-Dev-Account header names. DEVELOPMENT ONLY: refused in
# production. "oidc", the default, checks every request's access token against
# the Keycloak realm. With the local one (docker compose --profile auth up -d --wait):
#   FF_AUTH_MODE=oidc
#   FF_OIDC_ISSUER=http://localhost:8180/realms/ff
#   FF_OIDC_AUDIENCE=ff-api
# FF_DEV_USER_ID, used before 2026-10-17, is no longer read.
FF_AUTH_MODE=dev
FF_DEV_ACCOUNT_ID=000000000001
FF_OIDC_ISSUER=
FF_OIDC_AUDIENCE=

# E-mail (P-12). Without FF_SMTP_URL, e-mails are written to the backend's log.
# With the local Mailpit (docker compose --profile auth up -d --wait), set
# FF_SMTP_URL=smtp://localhost:51025 and read them at http://localhost:58025.
# FF_OPERATOR_EMAIL gets one e-mail per new account, which waits for your
# approval during the beta, with a link into the admin dashboard (FF_ADMIN_URL).
# Production requires FF_SMTP_URL and FF_OPERATOR_EMAIL.
FF_SMTP_URL=
FF_MAIL_FROM=FF <no-reply@ff.localhost>
FF_OPERATOR_EMAIL=operator@ff.localhost
FF_ADMIN_URL=http://localhost:5198
# The console, which invitation e-mails link to (P-16). Production requires it.
FF_CONSOLE_URL=http://localhost:5199

# Who sells, and where bank transfers go, as pro-formas say it (P-35): the
# seller's name, tax ID (matricule fiscal) and address, the bank and the IBAN
# (checked), and the BIC if any. These development values are no real seller
# or account; production requires real ones.
FF_SELLER_NAME=FF (development, not a seller)
FF_SELLER_TAX_ID=0000000/A/A/M/000
FF_SELLER_ADDRESS=Tunis, Tunisia
FF_BANK_NAME=Development bank: no transfer arrives
FF_BANK_IBAN=TN59 1000 6035 1835 9847 8831
FF_BANK_BIC=
