# Every variable is checked at boot, and a bad value stops the backend with a
# message naming it (src/config/configuration.ts). NODE_ENV=production also
# refuses the development settings marked below.

# Application
NODE_ENV=development
PORT=3000
# The console's and the admin dashboard's origins, comma-separated. Required in production.
CORS_ORIGIN=http://localhost:5199,http://localhost:5198

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Development default: refused in production
DB_PASSWORD=postgres
# The code reads DB_NAME (matches POSTGRES_DB in docker-compose.yml)
DB_NAME=serverless_platform
# TLS to the database: use it whenever the server is not on this host. The
# server's certificate is always verified, against DB_SSL_CA (a PEM file) when
# it is set, else against the system's CAs.
DB_SSL=false
DB_SSL_CA=

# FF's own object store, any S3-compatible one: in development SeaweedFS from
# docker-compose.yml, with the credentials from infrastructure/seaweedfs/s3.json
# (local development only: refused in production, as MinIO's old default
# minioadmin is). These were MINIO_* until 2026-10-23: the backend refuses the
# old names, saying each one's new name.
FF_OBJECT_STORE_ENDPOINT=localhost
FF_OBJECT_STORE_PORT=9003
FF_OBJECT_STORE_USE_SSL=false
FF_OBJECT_STORE_ACCESS_KEY=ffdevaccesskey
FF_OBJECT_STORE_SECRET_KEY=ffdevsecretkey-local-only
FF_OBJECT_STORE_BUCKET=functions

# Orchestrator (Kubernetes is the only driver, ADR 0001)
ORCHESTRATOR=kubernetes
# How long create/update wait for a function to become ready
FF_READY_TIMEOUT_SECONDS=90
# Each account's plan sets its limits: functions, memory, timeout, instances,
# its namespace's quota, its rate limits, and the idle time before scale to
# zero (plans.limits; client-readiness plan, P-15). The backend no longer reads
# FF_SCALE_TO_ZERO_IDLE_SECONDS or K8S_TENANT_QUOTA_*, and refuses to start
# while they are set.

# How often FF deletes what it keeps only for a while: invocation history older
# than the plan allows, and the data of accounts closed past their notice period.
FF_RETENTION_INTERVAL_SECONDS=3600

# Notifications: how often the backend sends the e-mails and webhooks that are
# due, and whether a webhook may reach a private address, such as a receiver on
# this machine. Production refuses true.
FF_NOTIFY_INTERVAL_SECONDS=10
FF_WEBHOOK_ALLOW_PRIVATE=true

# Alarms: how often they are evaluated, and how long a period has been over
# before it is judged, so that a call ending then still counts in it.
FF_ALARM_INTERVAL_SECONDS=60
FF_ALARM_SETTLE_SECONDS=60

# The backend's logs: one JSON object a line (json, production's default) or
# readable lines (text, development's). The operator's metrics, in Prometheus's
# text format, on their own port, never the API's; 0 serves none. In a cluster,
# FF_METRICS_HOST=0.0.0.0 lets the metrics store reach them; for the dev
# cluster's (hack/k8s/monitoring-up.sh), the address hack/k8s/host-address.sh
# prints. FF_DATABASE_DISK_BYTES is the database server's disk, for the alert
# on its size; 0: unknown, no alert.
FF_LOG_FORMAT=text
FF_METRICS_PORT=9464
FF_METRICS_HOST=127.0.0.1
FF_DATABASE_DISK_BYTES=0

# The API's OpenAPI document and its viewer at /api: on in development, off in
# production unless set. FF_TRUST_PROXY: the proxies in front of the backend
# whose X-Forwarded-For it believes (addresses, CIDRs, or loopback, linklocal,
# uniquelocal), so that the audit log and the rate limits see the caller; none
# by default, as in development nothing stands in front.
FF_API_DOCS=true
FF_TRUST_PROXY=

# Kubernetes (docs/kubernetes-dev-guide.md). hack/k8s/mint-token.sh prints
# these four for the dev cluster; inside a cluster leave them empty.
K8S_API_URL=https://127.0.0.1:6550
K8S_TOKEN_FILE=../hack/.kube/ff-controller.token
K8S_CA_FILE=../hack/.kube/ca.crt
K8S_INVOKE_MODE=proxy
# Only ff-t-: the admission policy lets the backend manage no other namespaces
K8S_NAMESPACE_PREFIX=ff-t-
K8S_RUNTIME_IMAGE_NODEJS=ff-runtime-nodejs:24-v3
K8S_RUNTIME_IMAGE_PYTHON=ff-runtime-python:3.13-v3
K8S_IMAGE_PULL_POLICY=IfNotPresent
# How long an invocation waits for a function scaled to zero to start again. A call still
# running after two timeouts, this, and 30 s lost its answer: the backend stopped during it,
# and marks it LOST, unbilled (P-20)
K8S_READY_TIMEOUT_SECONDS=90
# The sandbox functions run in, e.g. gvisor (needs the RuntimeClass and runsc on the nodes).
# Production refuses to start without one, unless K8S_ALLOW_UNSANDBOXED=true, which is only
# for a cluster that tries the platform's manifests, never with customers' code.
K8S_RUNTIME_CLASS=
K8S_ALLOW_UNSANDBOXED=false
# Each account's own setting decides whether its functions reach the internet: off until you
# turn it on in the admin dashboard. false cuts every account off, whatever its setting.
K8S_EGRESS_INTERNET=true
K8S_INGRESS_ALLOW_CIDRS=
# The log store's delete key (P-45): closing an account deletes its functions' log lines
# with it. hack/k8s/logging-up.sh (or hack/k8s/log-store-key.sh) writes it there from the
# cluster's Secret; inside a cluster, leave it unset: the Secret is mounted at the default.
K8S_LOG_STORE_DELETE_KEY_FILE=../hack/.kube/victoria-logs-delete-key

# Authentication (docs/adr/0004-identity-and-tenancy.md)
# "dev" acts as the account FF_DEV_ACCOUNT_ID (12 digits) without any token, or
# as the one an X-FF-Dev-Account header names. DEVELOPMENT ONLY: refused in
# production. "oidc", the default, checks every request's access token against
# the Keycloak realm. With the local one (docker compose --profile auth up -d --wait):
#   FF_AUTH_MODE=oidc
#   FF_OIDC_ISSUER=http://localhost:8180/realms/ff
#   FF_OIDC_AUDIENCE=ff-api
# FF_DEV_USER_ID, used before 2026-10-17, is no longer read.
FF_AUTH_MODE=dev
FF_DEV_ACCOUNT_ID=000000000001
FF_OIDC_ISSUER=
FF_OIDC_AUDIENCE=
# Where the realm's keys are, when not where its OpenID configuration says (in a cluster,
# Keycloak's own Service). Unset: found through FF_OIDC_ISSUER.
FF_OIDC_JWKS_URL=

# E-mail (P-12). Without FF_SMTP_URL, e-mails are written to the backend's log.
# With the local Mailpit (docker compose --profile auth up -d --wait), set
# FF_SMTP_URL=smtp://localhost:51025 and read them at http://localhost:58025.
# FF_OPERATOR_EMAIL gets one e-mail per new account, which waits for your
# approval during the beta, with a link into the admin dashboard (FF_ADMIN_URL).
# Production requires FF_SMTP_URL and FF_OPERATOR_EMAIL.
FF_SMTP_URL=
FF_MAIL_FROM=FF <no-reply@ff.localhost>
FF_OPERATOR_EMAIL=operator@ff.localhost
FF_ADMIN_URL=http://localhost:5198
# The console, which invitation e-mails link to (P-16). Production requires it.
FF_CONSOLE_URL=http://localhost:5199

# Who sells, and where bank transfers go, as pro-formas say it (P-35): the
# seller's name, tax ID (matricule fiscal) and address, the bank and the IBAN
# (checked), and the BIC if any. These development values are no real seller
# or account; production requires real ones.
FF_SELLER_NAME=FF (development, not a seller)
FF_SELLER_TAX_ID=0000000/A/A/M/000
FF_SELLER_ADDRESS=Tunis, Tunisia
FF_BANK_NAME=Development bank: no transfer arrives
FF_BANK_IBAN=TN59 1000 6035 1835 9847 8831
FF_BANK_BIC=

# Function URLs: the port of the server that answers them, apart from the API's
# (0: none), and the origin under which each URL is <id>.<host>. In development,
# http://<id>.fn.localhost:3001/, which browsers and curl take to this machine.
# Production requires an https:// origin, such as https://fn.example.tn.
FF_FUNCTION_URL_PORT=3001
FF_FUNCTION_URL_BASE=http://fn.localhost:3001
# Buckets' S3 front door: its port, and the endpoint AWS's SDKs and CLI are given (a bucket is <bucket>.s3.localhost too).
FF_STORAGE_PORT=3002
FF_STORAGE_BASE=http://s3.localhost:3002
# Functions' own keys to their account's buckets come with the address their pods reach the front door at, an IP
# address, where AWS's SDKs go path-style by themselves; and the addresses their NetworkPolicy opens, on its port
# (empty: the backend's own pods, as in production). Empty endpoint: functions get no key. With the development
# cluster, this machine as its pods see it, the gateway of its Docker network (172.18.0.1, usually):
#   docker network inspect k3d-ff-dev --format '{{(index .IPAM.Config 0).Gateway}}'
# then FF_STORAGE_FUNCTION_ENDPOINT=http://172.18.0.1:3002 and FF_STORAGE_FUNCTION_CIDRS=172.18.0.1/32.
FF_STORAGE_FUNCTION_ENDPOINT=
FF_STORAGE_FUNCTION_CIDRS=
# Queues' SQS endpoint: its port (0: none), and the endpoint AWS's SDKs and CLI are given, which a queue's URL
# begins with: <endpoint>/<account>/<queue>. Production requires an https:// origin, such as https://sqs.example.tn.
FF_SQS_PORT=3003
FF_SQS_BASE=http://localhost:3003
# Where functions' pods reach it with their own keys, AWS_ENDPOINT_URL_SQS, and the addresses their NetworkPolicy
# opens, on its port (empty: the backend's own pods, as in production). Empty endpoint: functions get no
# AWS_ENDPOINT_URL_SQS. With the development cluster, the same gateway as for buckets:
# FF_SQS_FUNCTION_ENDPOINT=http://172.18.0.1:3003 and FF_SQS_FUNCTION_CIDRS=172.18.0.1/32.
FF_SQS_FUNCTION_ENDPOINT=
FF_SQS_FUNCTION_CIDRS=

# Customers' own domains for function URLs. FF_EDGE_ADDRESSES: the edge's public
# addresses, comma-separated, which a domain apex must point to (empty: not
# checked). FF_DOMAIN_RESOLVERS: the DNS servers that check domains' records,
# such as 127.0.0.1:5353 for a test zone (empty: the system's).
FF_EDGE_ADDRESSES=
FF_DOMAIN_RESOLVERS=

# Schedules: how often the backend takes the due ones, in seconds (0: never,
# for a backend that runs none), and FF's region, which their events name.
FF_SCHEDULER_INTERVAL_SECONDS=5
FF_REGION=tn-tunis-1

# Asynchronous calls (the invocation type Event): each waits in its function's
# queue, and the backend claims it as soon as PostgreSQL tells it the call was
# kept; how often it looks for the ones due without being told, its retries and
# the claims a stopped backend lost, in seconds (0: never, for a backend that
# runs none); and how many it runs at once.
FF_ASYNC_INTERVAL_SECONDS=5
FF_ASYNC_CONCURRENCY=10

# The keys that encrypt functions' environment variables and secrets at rest:
# a file with one key a line, <id>:<32 bytes in base64>, the first sealing new
# values, every one opening what it sealed. Make one with
#   echo "$(date +%Y-%m):$(openssl rand -base64 32)" > keys && chmod 600 keys
# Empty: a development key that is written in the source and protects nothing;
# production requires the file, and refuses that key.
FF_ENCRYPTION_KEYS_FILE=

# Functions' code images (ADR 0003): every function's code runs as an image,
# inline code's too, pushed to FF_CODE_REGISTRY and pulled by the cluster's nodes
# from FF_CODE_REGISTRY_PULL (the same host by default). In development, the
# registry that hack/k8s/registry-up.sh runs next to the cluster, on
# 127.0.0.1:5056 for the backend and ff-dev-registry:5000 for the nodes. Empty:
# no function can be deployed (503); production requires it.
# A registry with a login takes FF_CODE_REGISTRY_USERNAME and _PASSWORD.
FF_CODE_REGISTRY=http://127.0.0.1:5056
FF_CODE_REGISTRY_PULL=ff-dev-registry:5000
FF_CODE_REGISTRY_USERNAME=
FF_CODE_REGISTRY_PASSWORD=

# Customers' databases (ADR 0008): their server, as customers and functions reach it. Empty: no databases, and the
# API's database routes answer 503. hack/k8s/data-db-up.sh starts the development one (docker-compose.yml's data-db,
# its profile "data") and prints these lines. FF_DATA_DB_ADMIN_HOST: where the backend reaches it, when not at
# FF_DATA_DB_HOST. FF_DATA_DB_CIDRS: the addresses functions reach it at, which their NetworkPolicy opens on its port
# whatever their account's internet access. FF_DATA_DB_CA_FILE: the CA of its certificate, when it isn't a public one:
# the backend checks the server against it, and functions' pods get it (Node.js trusts it through
# NODE_EXTRA_CA_CERTS). Production refuses the development password.
FF_DATA_DB_HOST=
FF_DATA_DB_PORT=5432
FF_DATA_DB_ADMIN_HOST=
FF_DATA_DB_ADMIN_USER=ff_admin
FF_DATA_DB_ADMIN_PASSWORD=
FF_DATA_DB_CIDRS=
FF_DATA_DB_CA_FILE=
