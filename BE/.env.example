# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# The code reads DB_NAME (matches POSTGRES_DB in docker-compose.yml)
DB_NAME=serverless_platform
DB_SYNC=false
DB_SSL=false

# S3-compatible storage. Variable names are still MINIO_* (renamed in parent
# plan F-15); the dev store is SeaweedFS from docker-compose.yml, with the
# credentials from infrastructure/seaweedfs/s3.json (local development only).
MINIO_ENDPOINT=localhost
MINIO_PORT=9003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ffdevaccesskey
MINIO_SECRET_KEY=ffdevsecretkey-local-only
MINIO_BUCKET_NAME=functions

# Orchestrator (Kubernetes is the only driver, ADR 0001)
ORCHESTRATOR=kubernetes
# How long create/update wait for a function to become ready
FF_READY_TIMEOUT_SECONDS=90
# Idle time before functions with scaleToZero and minInstances 0 are scaled to zero
FF_SCALE_TO_ZERO_IDLE_SECONDS=900

# Kubernetes (docs/kubernetes-dev-guide.md). hack/k8s/mint-token.sh prints
# these four for the dev cluster; inside a cluster leave them empty.
K8S_API_URL=https://127.0.0.1:6550
K8S_TOKEN_FILE=../hack/.kube/ff-controller.token
K8S_CA_FILE=../hack/.kube/ca.crt
K8S_INVOKE_MODE=proxy
K8S_NAMESPACE_PREFIX=ff-t-
K8S_RUNTIME_IMAGE_NODEJS=ff-runtime-nodejs:24-v1
K8S_RUNTIME_IMAGE_PYTHON=ff-runtime-python:3.13-v1
K8S_IMAGE_PULL_POLICY=IfNotPresent
# e.g. gvisor (needs the RuntimeClass and runsc on the nodes)
K8S_RUNTIME_CLASS=
K8S_EGRESS_INTERNET=true
K8S_INGRESS_ALLOW_CIDRS=
K8S_TENANT_QUOTA_PODS=20
K8S_TENANT_QUOTA_CPU=8
K8S_TENANT_QUOTA_MEMORY=8Gi

# Authentication
# DEVELOPMENT ONLY: tenant used when no authenticated user exists. Leave empty
# in production. "1" keeps functions created by the old hard-coded user visible.
FF_DEV_USER_ID=1
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=7d

# Function Configuration
FUNCTION_MEMORY_DEFAULT=128
FUNCTION_TIMEOUT_DEFAULT=30
FUNCTION_MAX_MEMORY=1024
FUNCTION_MAX_TIMEOUT=300

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
METRICS_INTERVAL=10000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev # dev or combined
LOG_DIR=logs

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cache
CACHE_TTL=3600
CACHE_MAX=100

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE=Serverless Platform API
SWAGGER_DESCRIPTION=API documentation for the Serverless Platform
SWAGGER_VERSION=1.0
SWAGGER_PATH=api-docs

# Security
SECURITY_ENABLE_RATE_LIMIT=true
SECURITY_ENABLE_HELMET=true
SECURITY_ENABLE_COMPRESSION=true
SECURITY_ENABLE_CORS=true

# Docker Configuration (for function containers)
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Debug
DEBUG_PORT=9229
DEBUG_ENABLED=false

# Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 0 * * *
BACKUP_DIR=/opt/backups

# Notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@example.com

# Feature Flags
FEATURE_PYTHON_RUNTIME=false
FEATURE_CUSTOM_DOMAINS=false
FEATURE_AUTO_SCALING=true
FEATURE_MONITORING=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
