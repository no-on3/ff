# NestJS ships its packages as ES modules only, and the backend is CommonJS: Node.js loads them with require(),
# but Jest needs this flag to do the same. npm and npx pass it to everything they run in BE/, so `npm test`
# and `npx jest <file>` both work; Node.js prints no warning for the experimental API on every run.
node-options=--experimental-vm-modules --disable-warning=ExperimentalWarning
