      {"title": "its URL, under AWS's host", "operation": "GetQueueAttributes", "input": {"QueueUrl": "https://sqs.{region}.amazonaws.com/{account}/orders", "AttributeNames": ["QueueArn"]}, "answer": {"Attributes": {"QueueArn": "arn:aws:sqs:{region}:{account}:orders"}}},
      {"title": "its URL, with a slash after it", "operation": "GetQueueAttributes", "input": {"QueueUrl": "{queueUrl}/", "AttributeNames": ["QueueArn"]}, "answer": {"Attributes": {"QueueArn": "arn:aws:sqs:{region}:{account}:orders"}}},
      {"title": "its URL, its path alone", "operation": "GetQueueAttributes", "input": {"QueueUrl": "/{account}/orders", "AttributeNames": ["QueueArn"]}, "answer": {"Attributes": {"QueueArn": "arn:aws:sqs:{region}:{account}:orders"}}}
    ],
    "notThere": [
