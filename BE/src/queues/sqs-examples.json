      {"title": "a queue the account hasn't", "operation": "SendMessage", "input": {"QueueUrl": "{endpoint}/{account}/gone", "MessageBody": "x"}, "refused": {"status": 400, "type": "QueueDoesNotExist", "message": "The specified queue does not exist."}},
      {"title": "no queue named", "operation": "SendMessage", "input": {"MessageBody": "x"}, "refused": {"status": 400, "type": "MissingParameter", "message": "The request must contain the parameter QueueUrl."}}
    ],
