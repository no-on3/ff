# Kubernetes migration (K-00): local tool binaries and cluster credentials
hack/bin/
hack/.kube/
# hack/k8s/data-db-up.sh: the development data server's CA, for the backend and functions' pods
hack/.data-db/
# hack/k8s/cache-up.sh: the development cache server's CA, for the backend and functions' pods
hack/.cache-server/
# hack/install-tools.sh: Rust, where the machine has none recent enough
hack/.rust/
*.kubeconfig

# End-to-end test work files (K-08)
hack/.e2e/
hack/.e2e-tenancy/
hack/.cli-e2e/
hack/.code-delivery-spike/
# hack/spikes/queue: pgmq's release, the SDKs, the dumps (step 3's spike)
hack/.spike-queue/
# hack/spikes/sites, mail and cache: the files, SDKs, images' work and results of step 4's spikes
hack/.spike-sites/
hack/.spike-mail/
hack/.spike-cache/
hack/.data-services-spike/
# Downloads the end-to-end scripts keep between runs, such as a package built with npm.
hack/.cache/
# hack/ci.sh: its work files, the scanner's database and the SBOMs
hack/.ci/
