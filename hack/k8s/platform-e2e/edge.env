FF_API_HOST=api.ff.test
FF_CONSOLE_HOST=console.ff.test
FF_ADMIN_HOST=admin.ff.test
FF_LOGIN_HOST=login.ff.test
FF_ACME_EMAIL=operator@ff.test
FF_ADMIN_ALLOW=192.0.2.1/32
FF_EDGE_TLS=local_certs
# Function URLs' certificates one per host, from Caddy's own authority: the test has no DNS server to update.
FF_FUNCTION_URL_DOMAIN=fn.ff.test
FF_FUNCTION_URL_TLS=on-demand
# Buckets' S3 endpoint and its buckets' hosts, the same way.
FF_STORAGE_HOST=s3.ff.test
FF_STORAGE_TLS=on-demand
# Queues' SQS endpoint, one host.
FF_SQS_HOST=sqs.ff.test
