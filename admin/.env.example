# The admin dashboard's settings (P-70), read when Vite starts or builds. Copy
# this file to .env.local (not committed) and change what you need.

# The API's address.
VITE_API_URL=http://localhost:3000
# The realm operators log in with: required, the dashboard has no development mode.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/ff
# The dashboard's client in that realm: the backend's admin routes take only its tokens.
VITE_OIDC_CLIENT_ID=ff-admin
