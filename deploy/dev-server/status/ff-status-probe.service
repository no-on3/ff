# The status page's probe (probe.sh, which setup.sh copies to /usr/local/lib/ff-status), each time
# ff-status-probe.timer says, as ff-status, a user of its own: it writes /data/ff/status/minutes.log, and nothing
# else. server.sh installs both in /etc/systemd/system. Its output: journalctl -u ff-status-probe.
[Unit]
Description=FF's status probe: each piece of FF, as a customer meets it
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ff-status
Group=ff-status
ExecStart=/bin/bash /usr/local/lib/ff-status/probe.sh
# Its checks run at once, each ended at 10 s; a minute's run still going after 50 s is ended, before the next.
TimeoutStartSec=50s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/data/ff/status
