# The status page's probe (probe.sh), then the page (render.py), each time ff-status-probe.timer says, as ff-status, a
# user of its own, from the copies setup.sh puts in /usr/local/lib/ff-status: they write in /data/ff/status alone.
# server.sh installs both units in /etc/systemd/system. Their output: journalctl -u ff-status-probe.
[Unit]
Description=FF's status probe: each piece of FF, as a customer meets it
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ff-status
Group=ff-status
ExecStart=-/bin/bash /usr/local/lib/ff-status/probe.sh
# Then the page, whatever the probe did, so that a probe that stopped writing shows on it as one.
ExecStart=/usr/bin/python3 -I /usr/local/lib/ff-status/render.py
# The probe's checks run at once, each ended at 10 s; a minute's run still going after 50 s is ended, before the next.
TimeoutStartSec=50s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/data/ff/status
