# The edge on FF's development server, behind the server's own proxy, which terminates the internet's TLS. The
# edge's own certificates come from its own authority (local_certs), which the proxy checks it against; function
# URLs', buckets' and sites' hosts get theirs on demand, once the backend says yes. FF's names here are the server's:
# server.sh and smoke.sh take the domain from FF_API_HOST. FF_ADMIN_ALLOW and FF_EDGE_TRUSTED_PROXIES are the
# server's overlay's.
FF_API_HOST=api.dev.ffunc.cloud
FF_CONSOLE_HOST=console.dev.ffunc.cloud
FF_ADMIN_HOST=admin.dev.ffunc.cloud
FF_LOGIN_HOST=login.dev.ffunc.cloud
FF_ACME_EMAIL=operator@dev.ffunc.cloud
FF_EDGE_TLS=local_certs
FF_FUNCTION_URL_DOMAIN=fn.dev.ffunc.cloud
FF_FUNCTION_URL_TLS=on-demand
FF_STORAGE_HOST=s3.dev.ffunc.cloud
FF_STORAGE_TLS=on-demand
FF_SQS_HOST=sqs.dev.ffunc.cloud
FF_WEBSITE_DOMAIN=site.dev.ffunc.cloud
FF_WEBSITE_TLS=on-demand
