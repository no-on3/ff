# The backend on FF's development server: FF's names under dev.ffunc.cloud, and the services beside the cluster.
# The seller's and the bank's details say what they are: no invoice from here is a real one.
DB_HOST=ff-dev-postgres.ff-system.svc.cluster.local
DB_SSL=false
FF_OBJECT_STORE_ENDPOINT=ff-dev-s3.ff-system.svc.cluster.local
FF_OBJECT_STORE_PORT=8333
FF_OBJECT_STORE_USE_SSL=false
FF_OIDC_ISSUER=https://login.dev.ffunc.cloud/realms/ff
CORS_ORIGIN=https://console.dev.ffunc.cloud,https://admin.dev.ffunc.cloud
FF_CONSOLE_URL=https://console.dev.ffunc.cloud
FF_ADMIN_URL=https://admin.dev.ffunc.cloud
FF_FUNCTION_URL_BASE=https://fn.dev.ffunc.cloud
FF_STORAGE_BASE=https://s3.dev.ffunc.cloud
FF_SQS_BASE=https://sqs.dev.ffunc.cloud
FF_WEBSITE_BASE=https://site.dev.ffunc.cloud
FF_MAIL_FROM=FF <no-reply@dev.ffunc.cloud>
FF_OPERATOR_EMAIL=operator@dev.ffunc.cloud
FF_SELLER_NAME=FF, development server
FF_SELLER_TAX_ID=0000000/A/M/000
FF_SELLER_ADDRESS=Development only, no address
FF_BANK_NAME=Development only
FF_BANK_IBAN=TN20 1400 6006 0100 0000 0001
# Customers' databases: their server's name, as connection strings give it, which the cluster's DNS answers with
# the address it listens on (server.sh); the backend's own address for it, and the one functions' NetworkPolicy
# opens, are the server's overlay's.
FF_DATA_DB_HOST=db.dev.ffunc.cloud
FF_DATA_DB_CA_FILE=/etc/ff/data-db-ca/ca.crt
