# Keycloak on FF's development server: its database beside the cluster, its mail to the server's Mailpit, which
# keeps every e-mail and sends none.
KC_DB_URL_HOST=ff-dev-postgres.ff-system.svc.cluster.local
KC_DB_URL_PROPERTIES=
KC_HOSTNAME=https://login.dev.ffunc.cloud
FF_CONSOLE_URL=https://console.dev.ffunc.cloud
FF_ADMIN_URL=https://admin.dev.ffunc.cloud
FF_SMTP_HOST=ff-dev-smtp.ff-system.svc.cluster.local
FF_SMTP_PORT=1025
FF_SMTP_FROM=no-reply@dev.ffunc.cloud
FF_SMTP_USER=no-reply@dev.ffunc.cloud
