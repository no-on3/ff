# WAL-G's settings, in PostgreSQL's environment. The second site: an S3 bucket at another provider, or another
# region, than the primary's. Every backup is encrypted before it leaves the server, with a key kept apart from
# both (WALG_LIBSODIUM_KEY: 32 random bytes, hex): without it, nothing can be restored.
WALG_S3_PREFIX=s3://ff-backups/postgres
AWS_ENDPOINT=https://s3.second-site.example
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_COMPRESSION_METHOD=zstd
PGHOST=/var/run/postgresql
