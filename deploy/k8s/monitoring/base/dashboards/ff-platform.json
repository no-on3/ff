      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "(sum(increase(ff_http_responses_total{class=\"5xx\"}[10m])) or vector(0)) / clamp_min(sum(increase(ff_http_responses_total[10m])), 1)",
          "legendFormat": "share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
