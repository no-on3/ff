# The backend's settings in the cluster, the ConfigMap ff-backend: what isn't secret. example.tn stands for FF's
# domain: an overlay gives the real values (deploy/k8s/README.md). The seller's and the bank's details aren't here:
# the backend refuses to start without them, rather than print an example on a pro-forma.
NODE_ENV=production
PORT=3000
FF_LOG_FORMAT=json
FF_METRICS_PORT=9464
FF_METRICS_HOST=0.0.0.0
DB_HOST=postgres.example.tn
DB_PORT=5432
DB_USERNAME=ff
DB_NAME=ff
DB_SSL=true
MINIO_ENDPOINT=s3.example.tn
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=functions
FF_AUTH_MODE=oidc
FF_OIDC_ISSUER=https://login.example.tn/realms/ff
FF_OIDC_AUDIENCE=ff-api
FF_OIDC_JWKS_URL=http://keycloak.ff-system.svc.cluster.local:8080/realms/ff/protocol/openid-connect/certs
CORS_ORIGIN=https://console.example.tn,https://admin.example.tn
FF_CONSOLE_URL=https://console.example.tn
FF_ADMIN_URL=https://admin.example.tn
FF_MAIL_FROM=FF <no-reply@example.tn>
FF_OPERATOR_EMAIL=operator@example.tn
FF_TRUST_PROXY=10.42.0.0/16
K8S_INVOKE_MODE=direct
