# The edge's settings, the ConfigMap ff-edge. example.tn stands for FF's domain. FF_ADMIN_ALLOW: the addresses or
# ranges, space apart, that reach the admin app and Keycloak's administration; the documentation range here
# reaches nobody, so nothing is open until an overlay names FF's own.
FF_API_HOST=api.example.tn
FF_CONSOLE_HOST=console.example.tn
FF_ADMIN_HOST=admin.example.tn
FF_LOGIN_HOST=login.example.tn
FF_ACME_EMAIL=operator@example.tn
FF_ADMIN_ALLOW=192.0.2.0/32
FF_EDGE_TLS=
# Functions' URLs: the function domain, FF_FUNCTION_URL_BASE's host in backend.env, and how its certificates come:
# wildcard, one for *.<domain> through DNS updates (RFC 2136) to FF_DNS_SERVER, signed with the TSIG key named here,
# whose secret is the Secret ff-edge-dns (FF_DNS_TSIG_KEY); or on-demand, one per host, after the backend's yes.
FF_FUNCTION_URL_DOMAIN=fn.example.tn
FF_FUNCTION_URL_TLS=wildcard
# Buckets' S3 endpoint, FF_STORAGE_BASE's host in backend.env, at which each bucket is <bucket>.<host> too, and how
# their certificates come, the same two ways, through the same DNS server.
FF_STORAGE_HOST=s3.example.tn
FF_STORAGE_TLS=wildcard
# Queues' SQS endpoint, FF_SQS_BASE's host in backend.env: one name, whose certificate comes as the API's does.
FF_SQS_HOST=sqs.example.tn
FF_DNS_SERVER=192.0.2.53:53
FF_DNS_TSIG_KEY_NAME=ff-acme.
FF_DNS_TSIG_KEY_ALG=hmac-sha256
