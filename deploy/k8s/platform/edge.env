# The edge's settings, the ConfigMap ff-edge. example.tn stands for FF's domain. FF_ADMIN_ALLOW: the addresses or
# ranges, space apart, that reach the admin app and Keycloak's administration; the documentation range here
# reaches nobody, so nothing is open until an overlay names FF's own.
FF_API_HOST=api.example.tn
FF_CONSOLE_HOST=console.example.tn
FF_ADMIN_HOST=admin.example.tn
FF_LOGIN_HOST=login.example.tn
FF_ACME_EMAIL=operator@example.tn
FF_ADMIN_ALLOW=192.0.2.0/32
FF_EDGE_TLS=
