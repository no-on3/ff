# FF's edge: TLS for the API, the console, the admin app and the login, each on its hostname, for functions' URLs,
# every host under the function domain, and for buckets' S3 endpoint and every bucket's host under it; certificates
# from Let's Encrypt (ACME), kept on the edge's volume.
# Every value is the edge's environment (edge.env, and the Secret ff-edge-dns), read when Caddy starts. The admin
# app, and Keycloak's own admin console, answer only the addresses FF_ADMIN_ALLOW names; everyone else gets 403.
# The caller's address is the connection's: the Service keeps it (externalTrafficPolicy: Local), and each app
# behind is told it in X-Forwarded-For.
{
	admin off
	email {$FF_ACME_EMAIL}
	http_port 8080
	https_port 8443
	# Empty in production. A test sets it to local_certs: certificates from Caddy's own authority, offline, which
	# it doesn't try to add to the machine's trusted ones.
	{$FF_EDGE_TLS}
	skip_install_trust
	# Caddy's own redirects would name its port, 8443: the one below names none, so 443.
	auto_https disable_redirects
	# A certificate on demand (a function URL's host with FF_FUNCTION_URL_TLS=on-demand, a bucket's with
	# FF_STORAGE_TLS=on-demand, a customer's own domain always) only for a host the backend says is one, verified:
	# nobody makes the edge ask a certificate authority for names of their choosing.
	on_demand_tls {
		ask http://ff-backend.ff-system.svc.cluster.local:3001/tls/allowed
	}
	log {
		output stdout
		format json
	}
}

# Plain HTTP: to HTTPS, on its standard port, a 308 keeping the method and the body. Let's Encrypt's checks on
# port 80 are answered before this.
http:// {
	redir https://{host}{uri} 308
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log
}

{$FF_API_HOST} {
	import common
	reverse_proxy ff-backend.ff-system.svc.cluster.local:80
}

# Function URLs' certificates, as FF_FUNCTION_URL_TLS chooses, and buckets' as FF_STORAGE_TLS does: one for
# *.<domain>, which Let's Encrypt issues only through DNS (DNS-01), here by RFC 2136 updates signed with a TSIG key; or
# one per host, at the host's first request, once the backend says yes (50 a week per registered domain, Let's
# Encrypt's limit, for function URLs and buckets together: a small beta's).
(function-url-tls-wildcard) {
	tls {
		dns rfc2136 {
			server {$FF_DNS_SERVER}
			key_name {$FF_DNS_TSIG_KEY_NAME}
			key_alg {$FF_DNS_TSIG_KEY_ALG}
			key {$FF_DNS_TSIG_KEY}
		}
	}
}

(function-url-tls-on-demand) {
	tls {
		on_demand
	}
}

# Functions' URLs, <id>.<function domain>, to the backend's function URL gateway, as the callers sent them: no
# compression of the functions' answers, which are theirs.
*.{$FF_FUNCTION_URL_DOMAIN} {
	import function-url-tls-{$FF_FUNCTION_URL_TLS}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log
	reverse_proxy ff-backend.ff-system.svc.cluster.local:3001
}

# Buckets' S3 endpoint and each bucket's host under it, virtual-hosted, to the backend's S3 front door, as the
# clients sent them: their signatures cover the host, the path and the headers, so nothing is rewritten, added or
# compressed, and bodies stream both ways. Their certificate as FF_STORAGE_TLS chooses: one for both names through
# DNS, or one per host on demand, once the backend says the bucket is one.
{$FF_STORAGE_HOST}, *.{$FF_STORAGE_HOST} {
	import function-url-tls-{$FF_STORAGE_TLS}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log
	reverse_proxy ff-backend.ff-system.svc.cluster.local:3002
}

# Customers' own domains for their functions' URLs, each proved by DNS: every other host, its certificate made on
# demand at its first request once the backend says the domain is verified, else the handshake fails. Without HSTS:
# the domain is the customer's, and its other names too.
https:// {
	tls {
		on_demand
	}
	header -Server
	log
	reverse_proxy ff-backend.ff-system.svc.cluster.local:3001
}

{$FF_CONSOLE_HOST} {
	import common
	reverse_proxy ff-console.ff-system.svc.cluster.local:80
}

{$FF_ADMIN_HOST} {
	import common
	@outside not remote_ip {$FF_ADMIN_ALLOW}
	respond @outside "Forbidden: the admin dashboard answers FF's own addresses only" 403
	reverse_proxy ff-admin.ff-system.svc.cluster.local:80
}

{$FF_LOGIN_HOST} {
	import common
	# Keycloak's admin console and its API, for FF's addresses only; the login pages and tokens for everyone.
	@admin {
		path /admin /admin/*
		not remote_ip {$FF_ADMIN_ALLOW}
	}
	respond @admin "Forbidden: Keycloak's administration answers FF's own addresses only" 403
	reverse_proxy keycloak.ff-system.svc.cluster.local:8080
}
