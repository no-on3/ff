# Keycloak's settings, the ConfigMap keycloak: what isn't secret. example.tn stands for FF's domain.
KC_DB=postgres
KC_DB_URL_HOST=postgres.example.tn
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_URL_PROPERTIES=?sslmode=require
KC_DB_USERNAME=keycloak
KC_HOSTNAME=https://login.example.tn
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
# The realm's, read as it is imported (keycloak/ff-realm.json).
FF_CONSOLE_URL=https://console.example.tn
FF_ADMIN_URL=https://admin.example.tn
FF_SMTP_HOST=smtp.example.tn
FF_SMTP_PORT=587
FF_SMTP_FROM=no-reply@example.tn
FF_SMTP_USER=no-reply@example.tn
